# ============================================================
# VARIABLES DE ENTORNO — Rosto Facturación (Backend)
# Copia este archivo a `.env` y completa los valores reales.
# NUNCA commitees el archivo `.env` (ya está en .gitignore).
# ============================================================

# Puerto HTTP donde escucha la API (default: 4000)
PORT=4000

# ---- Oracle (Autonomous Database / Oracle Cloud) ----
# Usuario de la base de datos (no el administrador del tenancy).
ORACLE_USER=ADMIN
# Contraseña del usuario de la BD.
ORACLE_PASSWORD=
# Cadena de conexión. En Autonomous Database se usa el nombre del servicio,
# ej: "pollo_adw_high" (con wallet) o una cadena TCPS completa.
ORACLE_CONNECT_STRING=localhost:1521/XEPDB1
# Directorio del Oracle Wallet (carpeta con tnsnames.ora, cwallet.sso, ...).
# Se usa para conexión mTLS con Autonomous Database. Déjalo vacío si no usas wallet.
# El wallet debe subirse como secreto en Render, no en el repo.
ORACLE_WALLET_DIR=

# ---- Autenticación JWT ----
# Secreto para firmar los tokens. Debe ser largo y aleatorio.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-este-secreto-por-uno-seguro
# Expiración del token JWT (sintaxis jsonwebtoken), ej: 8h, 1d.
JWT_EXPIRES_IN=8h

# ---- Almacenamiento de imágenes de productos ----
# cloudinary | url
# - cloudinary: sube la imagen a Cloudinary (requiere credenciales abajo).
#   Si IMAGE_STORAGE=cloudinary pero faltan credenciales, degrada a modo 'url'.
# - url: guarda la imagen como una URL directa en el campo imagen_url.
# Para extenderlo a almacenamiento BLOB en Oracle: ver service/imageService.js;
# solo hay que devolver/guardar el buffer y usar un campo BLOB en la BD.
IMAGE_STORAGE=cloudinary

# ---- Cloudinary (solo si IMAGE_STORAGE=cloudinary) ----
# Credenciales desde el dashboard de Cloudinary (Cloudinary Console).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- CORS ----
# Origen permitido para peticiones del navegador.
# En producción usa el dominio de GitHub Pages (ej: https://tucuenta.github.io).
# Si queda vacío, en desarrollo se permite http://localhost:5173 (Vite).
CORS_ORIGIN=http://localhost:5173

# ---- Impuestos ----
# Porcentaje de IVA en Colombia (default: 19).
IMPUESTO_PORCENTAJE=19
